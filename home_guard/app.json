{
  "expo": {
    "name": "home-guard",
    "slug": "home-guard",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "homeguard",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.korrelaatiokomppania.homeguard",
      "googleServicesFile": "./google-services.json",
      "permissions": ["android.permission.POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 449,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Home Guard to use the camera to verify your safety tasks.",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "c5f34d2b-bc7c-4f95-bf3a-92b8e6de1ba9"
      }
    },
    "owner": "miro.i12"
  }
}
